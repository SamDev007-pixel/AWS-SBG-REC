# ==============================================================================
# AWS SBG REC Monorepo - Global Environment Variables Template
# ==============================================================================

# ── Database (PostgreSQL with pgvector) ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword123
POSTGRES_DB=aws_sbg_rec
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgrespassword123@localhost:5432/aws_sbg_rec?schema=public

# ── Redis Cache & Queues ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword123

# ── Backend Configuration ─────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-long
JWT_EXPIRATION=7d
FRONTEND_URL=http://localhost:3000

# ── Frontend Configuration ────────────────────────────────────────────────────
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Cloudinary Media Storage (Optional) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AWS Bedrock AI Chatbot (Optional) ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── SMTP Email Dispatch (Optional) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AWS SBG REC <no-reply@awsclub.dev>"
